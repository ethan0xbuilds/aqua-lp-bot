{
  "name": "aqua-lp-bot",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "^0.3.0",
    "@1inch/swap-vm-sdk": "^0.4.0",
    "dotenv": "^17.4.2",
    "viem": "^2.55.18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
